  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "actauth": "^0.0.2",
    "contextclip": "^0.0.1",
    "ioredis": "^6.0.0",
    "mcpplug": "^0.0.1",
    "openai": "^7.4.0",
    "reflowkit": "^0.0.1",
    "sessionknit": "^0.0.2",
    "skillgarden": "^0.0.5",
    "toollane": "^0.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
