  "description": "Runtime for tool-using AI agents with a transparent ReAct loop.",
  "license": "MIT",
  "homepage": "https://loopengine.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanyan22/loopengine.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loopengine": "dist/cli.js"
  },
  "imports": {
    "#*": "./*"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/run-agent.js",
    "dist/run-agent.d.ts",
    "dist/agent-config.js",
    "dist/agent-config.d.ts",
    "dist/session-store.js",
    "dist/session-store.d.ts",
    "dist/vector-index.js",
    "dist/vector-index.d.ts",
    "dist/model-calls/anthropic-model-call.js",
    "dist/model-calls/anthropic-model-call.d.ts",
    "dist/model-calls/openai-model-call.js",
    "dist/model-calls/openai-model-call.d.ts",
    "dist/model-calls/deepseek-model-call.js",
    "dist/model-calls/deepseek-model-call.d.ts",
    "dist/discover-agents.js",
    "dist/discover-agents.d.ts",
    "dist/agent-as-tool.js",
    "dist/agent-as-tool.d.ts",
    "LICENSE"
