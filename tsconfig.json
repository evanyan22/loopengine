{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["*.ts", "adapters/*.ts", "bin/*.ts", "core/*.ts", "core/model-calls/*.ts", "core/system-tools/*.ts", "web/*.ts", "agents/**/*.ts", "examples/approver/*.ts", "scripts/*.ts"]
}
